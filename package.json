{
  "name": "netlify-plugin-ttl-cache",
  "version": "0.0.1",
  "type": "module",
  "description": "A Netlify plugin for persisting immutable build assets across releases.",
  "keywords": [
    "netlify",
    "netlify-plugin",
    "cache",
    "ttl"
  ],
  "author": "Andy Richardson (andyrichardson), jason@getchipdrop.com",
  "license": "MIT",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "manifest.yml"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "typecheck": "tsc --noEmit -p .",
    "lint": "yarn typecheck && eslint . --ext .ts",
    "prepublishOnly": "yarn build && yarn lint && yarn test"
  },
  "devDependencies": {
    "@netlify/build": "^33.5.0",
    "@types/node": "^24.0.8",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vitest": "^0.5.4",
    "prettier": "^3.6.2",
    "ts-jest-resolver": "^2.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^1"
  },
  "engines": {
    "node": "22.x",
    "npm": ">= 10",
    "yarn": ">= 1.21.1"
  },
  "dependencies": {}
}
