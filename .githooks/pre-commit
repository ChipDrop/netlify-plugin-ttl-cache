#!/usr/bin/env bash

# dist/ is tracked in git so consumers who install via a git URL
# (e.g. github:ChipDrop/netlify-plugin-ttl-cache) get pre-built output
# without needing a publish step.
#
# This hook rebuilds dist/ and stages it so the committed build artifacts
# always stay in sync with the TypeScript source.
npm run build
git add dist/
